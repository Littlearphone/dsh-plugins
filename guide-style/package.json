{
  "name": "@local/guide-style",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Restyles the right sidebar's guide page as a centred grid of square tiles. Presentation only.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  }
}
