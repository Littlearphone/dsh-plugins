{
    "name":  "@local/services",
    "version":  "0.1.18",
    "private":  true,
    "type":  "module",
    "description":  "Workspace start scripts for the Web GUI: a right-sidebar panel plus a Session-header dropdown.",
    "exports":  {
                    ".":  "./index.js",
                    "./client":  "./client.js",
                    "./locale/*.json":  "./locale/*.json",
                    "./icon":  "./icon.svg"
                },
    "files":  [
                  "index.js",
                  "config.js",
                  "discover.js",
                  "jdk.js",
                  "download.js",
                  "processes.js",
                  "routes.js",
                  "client.js",
                  "client.data.js",
                  "client.css.js",
                  "client.store.js",
                  "client.editor.js",
                  "client.actions.js",
                  "client.panel.js",
                  "client.menu.js",
                  "client.toast.js",
                  "client.download.js",
                  "cordis.patch.yml",
                  "locale/*.json",
                  "icon.svg"
              ],
    "dsh":  {
                "bundle":  {
                               "patch":  "./cordis.patch.yml"
                           },
                "client":  {
                               "platform":  "web",
                               "immediately":  true,
                               "inject":  [
                                              "@deepseek-ai/dsh-client-locale",
                                              "@deepseek-ai/dsh-client-ui-sidebar-right"
                                          ]
                           }
            }
}
